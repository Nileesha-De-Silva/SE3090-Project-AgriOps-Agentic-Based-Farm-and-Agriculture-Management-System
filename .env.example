# ==============================================================================
# AgriOps AI - Master Full-Stack Environment Template
# ==============================================================================

# 1. Google Gemini AI API Configuration
GOOGLE_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
CHAT_MODEL=gemini-3.6-flash

# 2. Database Connection
ASPNETCORE_ENVIRONMENT=Development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agriops_db
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agriops_db;Username=postgres;Password=YOUR_DB_PASSWORD

# 3. Service URLs
BACKEND_API_URL=http://localhost:5286/api
VITE_API_URL=/api
VITE_AI_URL=/ai

# 4. Agent Configuration
PYTHONUNBUFFERED=1
MAX_MODEL_ATTEMPTS=2
MODEL_TIMEOUT_SECONDS=30
BACKEND_TIMEOUT_SECONDS=10
