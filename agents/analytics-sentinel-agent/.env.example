# ==============================================================================
# AgriOps Agent 4: Production Analytics & Operations Sentinel Agent
# Environment Configuration Template
# Copy this file to .env locally: cp .env.example .env
# ==============================================================================

# --- 1. Google Gemini AI API Configuration ---
# Google Gemini / AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Chat Model (recommended: gemini-2.5-flash or gemini-3.6-flash)
CHAT_MODEL=gemini-2.5-flash

# Toggle mock LLM evaluation for offline testing (true / false)
USE_MOCK_LLM=false

# --- 2. ASP.NET Core Backend Integration ---
# Base API URL for AgriOps Backend (.NET 10)
# Local development: http://localhost:5286/api
# Docker container network: http://backend:8080/api
# Docker-to-host: http://host.docker.internal:5286/api
BACKEND_API_URL=http://localhost:5286/api

# Service-to-service JWT Bearer token with SentinelAgent / AnalyticsAgent role
# Leave blank for local development / testing
BACKEND_AGENT_TOKEN=

# --- 3. LangGraph Checkpointing & Persistence ---
# SQLite database path for state graph checkpointing & human-in-the-loop resumes
CHECKPOINT_DB=data/sentinel_checkpoints.sqlite

# --- 4. Reliability & Execution Bounds ---
# Maximum timeout in seconds for Gemini LLM calls (1 to 60)
MODEL_TIMEOUT_SECONDS=30

# Maximum timeout in seconds for backend HTTP calls (1 to 30)
BACKEND_TIMEOUT_SECONDS=15

# Maximum retry attempts for LLM structured output parsing (1 to 3)
MAX_MODEL_ATTEMPTS=2

# --- 5. Server & Runtime ---
# Agent 4 service host and port
HOST=0.0.0.0
PORT=8004
PYTHONUNBUFFERED=1
