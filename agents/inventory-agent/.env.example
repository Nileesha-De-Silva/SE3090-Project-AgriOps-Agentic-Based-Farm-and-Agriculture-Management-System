# Copy to .env locally. Never commit real credentials.
BACKEND_API_URL=http://localhost:5289/api
# Full workflow: separate JWT with role InventoryAgent; never a Manager token.
# Leave blank for the standalone test_gemini.py sample-data test.
BACKEND_AGENT_TOKEN=
GEMINI_API_KEY=
# Select a currently available Gemini chat model from your team's AI Studio project.
CHAT_MODEL=
CHECKPOINT_DB=data/checkpoints.sqlite
MODEL_TIMEOUT_SECONDS=30
BACKEND_TIMEOUT_SECONDS=10
MAX_MODEL_ATTEMPTS=2
# Single process only: run uvicorn with --workers 1.
