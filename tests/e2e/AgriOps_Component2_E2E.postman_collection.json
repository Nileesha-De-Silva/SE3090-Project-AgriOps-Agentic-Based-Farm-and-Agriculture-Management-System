    {
      "name": "Phase 3: AI Crop Diagnostic Scouting & Gatekeeper Approval (C2 & AI)",
      "item": [
        {
          "name": "05 - Mobile Scout Submits Crop Health Observation (Mobile Simulation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Assessment Placed in PendingApproval Gate\", function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.status).to.eql(\"PendingApproval\");",
                  "    pm.expect(jsonData.suggestedTaskType).to.eql(\"PestInspection\");",
                  "});",
                  "pm.environment.set(\"assessmentId\", jsonData.id);",
                  "pm.environment.set(\"workflowId\", jsonData.workflowId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "User-Agent", "value": "AgriOps-Mobile/1.0.0 (Android; Flutter)" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fieldId\": \"{{fieldId}}\",\n  \"cropVariety\": \"BG 352 (Rice)\",\n  \"growthStage\": \"Tillering\",\n  \"observationText\": \"Rhizoctonia solani (Sheath Blight) oval lesions observed at water line\",\n  \"imageUrl\": \"https://cdn.agriops.local/scouting/sheath-blight-paddy4.jpg\",\n  \"submittedByUserId\": \"{{workerUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cropanalysis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cropanalysis"]
            }
          }
        },
        {
          "name": "06 - Web Dashboard Queries Pending Approvals Queue (Web Simulation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var list = pm.response.json();",
                  "pm.test(\"Submitted assessment is in pending queue\", function () {",
                  "    var item = list.find(a => a.id === pm.environment.get(\"assessmentId\"));",
                  "    pm.expect(item).to.not.be.undefined;",
                  "    pm.expect(item.status).to.eql(\"PendingApproval\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "User-Agent", "value": "AgriOps-Web/1.0.0 (React/Vite)" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cropanalysis/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cropanalysis", "pending"]
            }
          }
        },
        {
          "name": "07 - Web Manager Approves Diagnostic -> Auto-Provisions Remediation Task (Web)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var task = pm.response.json();",
                  "pm.test(\"Remediation Task Generated Successfully in Pending State\", function () {",
                  "    pm.expect(task.id).to.be.a('string');",
                  "    pm.expect(task.status).to.eql(\"Pending\");",
                  "    pm.expect(task.fieldId).to.eql(pm.environment.get(\"fieldId\"));",
                  "    pm.expect(task.taskType).to.eql(\"PestInspection\");",
                  "});",
                  "pm.environment.set(\"taskId\", task.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "User-Agent", "value": "AgriOps-Web/1.0.0 (React/Vite)" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"managerUserId\": \"{{managerUserId}}\",\n  \"comments\": \"Approved AI recommendation. Complete foliar disease inspection.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cropanalysis/{{assessmentId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cropanalysis", "{{assessmentId}}", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "Phase 4: Workforce Matching & Dispatch Execution (C2)",
      "item": [
