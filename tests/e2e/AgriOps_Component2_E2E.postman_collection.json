      ]
    },
    {
      "name": "Phase 6: Component 4 Immutable Audit Trail Verification",
      "item": [
        {
          "name": "15 - Verify Complete Task History & Audit Trail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var history = pm.response.json();",
                  "pm.test(\"Full audit chain captured (> 5 events)\", function () {",
                  "    pm.expect(history.length).to.be.at.least(5);",
                  "});",
                  "pm.test(\"Contains Creation transition\", function () {",
                  "    var hasCreated = history.some(h => h.newStatus === 'Pending');",
                  "    pm.expect(hasCreated).to.be.true;",
                  "});",
                  "pm.test(\"Contains Assignment transition\", function () {",
                  "    var hasAssigned = history.some(h => h.newStatus === 'Assigned');",
                  "    pm.expect(hasAssigned).to.be.true;",
                  "});",
                  "pm.test(\"Contains InProgress transition\", function () {",
                  "    var hasInProgress = history.some(h => h.newStatus === 'InProgress');",
                  "    pm.expect(hasInProgress).to.be.true;",
                  "});",
                  "pm.test(\"Contains Rework Rejection feedback\", function () {",
                  "    var hasReject = history.some(h => h.previousStatus === 'PendingVerification' && h.newStatus === 'InProgress');",
                  "    pm.expect(hasReject).to.be.true;",
                  "});",
                  "pm.test(\"Contains Final Completed transition\", function () {",
                  "    var hasCompleted = history.some(h => h.newStatus === 'Completed');",
                  "    pm.expect(hasCompleted).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "User-Agent", "value": "AgriOps-Web/1.0.0 (React/Vite)" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "history"]
            }
          }
        }
      ]
    }
  ]
}
