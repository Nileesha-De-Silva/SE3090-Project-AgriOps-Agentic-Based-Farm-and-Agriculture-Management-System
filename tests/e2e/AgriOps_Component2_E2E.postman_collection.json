{
  "info": {
    "_postman_id": "c2-e2e-workflow-test-suite-001",
    "name": "AgriOps Component 2 - End-to-End & Integration Test Suite",
    "description": "Comprehensive E2E and Cross-Platform Integration test collection for Component 2 (Nileesha De Silva). Covers API Integration, Cross-Component Integration (C1 -> C2 -> C4), Complete Business Workflow (Scouting -> AI Gate -> Task -> Dispatch -> Execution -> Evidence Verification -> Audit), and Cross-Platform Client Simulation (Mobile Flutter Client & Web React Dashboard).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Phase 1: Cross-Component Setup (Component 1 Farm & Field)",
      "item": [
        {
          "name": "01 - Create Farm (C1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Farm ID is returned\", function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "});",
                  "pm.environment.set(\"farmId\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "User-Agent", "value": "AgriOps-Web/1.0.0 (React/Vite)" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E AgriOps Research Farm\",\n  \"location\": \"Sector 4 - Mahaweli Zone B\",\n  \"totalArea\": 25.5,\n  \"ownerId\": \"{{managerUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/farm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farm"]
            }
          }
        },
        {
