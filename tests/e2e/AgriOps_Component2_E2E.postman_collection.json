    {
      "name": "Phase 5: Cross-Platform Field Execution & Evidence Verification Loop",
      "item": [
        {
          "name": "10 - Mobile Worker Starts Task (Mobile Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
