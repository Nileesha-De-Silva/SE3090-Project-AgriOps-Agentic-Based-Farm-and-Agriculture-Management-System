                  "});",
                  "var task = pm.response.json();",
                  "pm.test(\"Task Status updated to InProgress\", function () {",
                  "    pm.expect(task.status).to.eql(\"InProgress\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "User-Agent", "value": "AgriOps-Mobile/1.0.0 (Android; Flutter)" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newStatus\": \"InProgress\",\n  \"userId\": \"{{workerUserId}}\",\n  \"remarks\": \"Foliar inspection initiated across block Gamma-4.\"\n}"
