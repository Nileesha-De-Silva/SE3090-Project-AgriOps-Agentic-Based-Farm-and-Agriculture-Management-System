        },
        {
          "name": "14 - Web Manager Approves Evidence -> Task Completed (Web Dashboard)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var task = pm.response.json();",
                  "pm.test(\"Task Status finalized as Completed\", function () {",
                  "    pm.expect(task.status).to.eql(\"Completed\");",
                  "});"
                ],
                "type": "text/javascript"
