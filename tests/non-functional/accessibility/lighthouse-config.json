{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://localhost:5173/",
        "http://localhost:5173/tasks",
        "http://localhost:5173/crop-analysis",
        "http://localhost:5173/workers"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.90 }],
        "color-contrast": "error",
        "aria-roles": "error",
        "button-name": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "link-name": "error",
        "tap-targets": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
